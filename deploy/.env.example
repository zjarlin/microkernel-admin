# micro-admin 部署参数（复制为 deploy/.env，chmod 600）。
# 这是本服务唯一的默认值来源：编排与其他脚本都只引用这里的变量。

# 本机构建的镜像标签；换标签后 `docker compose up -d` 即完成发布。
MICRO_ADMIN_IMAGE=micro-admin:local

# 宿主机端口（只绑 127.0.0.1，由 localmesh Caddy 反代成 *.lyokm.cn）。
MICRO_ADMIN_HOST_PORT=5188

# SQLite 数据目录（bind mount，约定落在 ~/DockerCompose/<name>/data）。
MICRO_ADMIN_DATA_DIR=/root/DockerCompose/micro-admin/data

# 改页面配置所需权限码（与 schema.permissions 同一命名空间）。
SCHEMA_WRITE_PERMISSION=system:page:config

# 同源部署留空；跨域部署才逗号分隔填来源。
CORS_ORIGINS=

# AI 网关（与 Codex 用的是同一个 sub2api；容器内用 host-gateway 名，不写死 IP）。
# AI_API_KEY 只写在这里，不要进仓库；留空则服务端回落到 ~/.codex 配置。
AI_BASE_URL=http://127.0.0.1:18080
AI_MODEL=ds
AI_API_KEY=

# 组态画面 → IFC 的「缺参追问」复用上面这把 key（同一网关、同一份密钥），
# 所以默认不需要额外配置；只有想给它换模型/超时/关掉异步时才填下面这几项。
# EXTRUSION_MODEL=gpt-4.1-mini
# EXTRUSION_AI_BACKGROUND=1
# EXTRUSION_AI_TIMEOUT_MS=90000
# EXTRUSION_AI_POLL_MS=900

# 页面助手（alibaba/page-agent）：下面四项**只在存储里还没有设置时播种一次**，
# 之后界面（系统工具 → 页面助手）是唯一真源，改配置不需要改这里、也不需要发版。
# 留着是为了全新部署能直接用；PAGE_AGENT_ENABLED=false 可整站关闭入口。
# 该插件改配置需要权限码 system:page-agent:config。
PAGE_AGENT_BASE_URL=http://127.0.0.1:18080/v1
PAGE_AGENT_MODEL=ds
PAGE_AGENT_API_KEY=
PAGE_AGENT_ENABLED=true
