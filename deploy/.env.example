# micro-admin 部署参数（复制为 deploy/.env，chmod 600）。
# 这是本服务唯一的默认值来源：编排与其他脚本都只引用这里的变量。

# 本机构建的镜像标签；换标签后 `docker compose up -d` 即完成发布。
MICRO_ADMIN_IMAGE=micro-admin:local

# 宿主机端口（只绑 127.0.0.1，由 localmesh Caddy 反代成 *.lyokm.cn）。
MICRO_ADMIN_HOST_PORT=5188

# SQLite 数据目录（bind mount，约定落在 ~/DockerCompose/<name>/data）。
MICRO_ADMIN_DATA_DIR=/root/DockerCompose/micro-admin/data

# 改页面配置所需权限码（与 schema.permissions 同一命名空间）。
SCHEMA_WRITE_PERMISSION=system:page:config

# 同源部署留空；跨域部署才逗号分隔填来源。
CORS_ORIGINS=

# AI 网关（与 Codex 用的是同一个 sub2api；容器内用 host-gateway 名，不写死 IP）。
# AI_API_KEY 只写在这里，不要进仓库；留空则服务端回落到 ~/.codex 配置。
AI_BASE_URL=http://host.docker.internal:18080
AI_MODEL=ds
AI_API_KEY=
