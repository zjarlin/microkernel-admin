{
  "name": "micro-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "pnpm build:packages && vue-tsc -b && vite build",
    "build:packages": "pnpm --filter @addzero/data-page build && pnpm --filter @addzero/ui-server build && pnpm --filter @addzero/app-frame build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "dev:server": "node --env-file-if-exists=.env.local server/main.ts",
    "start:server": "node server/main.ts",
    "typecheck:server": "tsc -b server"
  },
  "dependencies": {
    "@addzero/app-frame": "workspace:*",
    "@addzero/data-page": "workspace:*",
    "@addzero/data-page-element": "workspace:*",
    "@addzero/ui-server": "workspace:*",
    "@element-plus/icons-vue": "^2.3.2",
    "@hono/node-server": "^1.19.17",
    "element-plus": "^2.14.7",
    "hono": "^4.13.14",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "jsdom": "^30.1.3",
    "playwright-core": "1.62.0",
    "sass": "^1.106.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
