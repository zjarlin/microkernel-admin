{
  "name": "@addzero/data-page",
  "version": "0.1.0",
  "description": "配置驱动的通用页面层：schema 契约、CRUD 引擎与页面状态机（无 UI 依赖）",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjarlin/micro-admin.git",
    "directory": "packages/data-page"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./engine": "./src/engine.ts",
    "./transport": "./src/transport.ts",
    "./rules": "./src/rules.ts",
    "./validate": "./src/validate.ts",
    "./tree": "./src/tree.ts",
    "./schema-client": "./src/schema-client.ts",
    "./use-page": "./src/usePage.ts",
    "./use-tree": "./src/useTree.ts",
    "./use-form-dialog": "./src/useFormDialog.ts",
    "./use-actions": "./src/useActions.ts",
    "./use-references": "./src/useReferences.ts",
    "./format": "./src/format.ts",
    "./vibe": "./src/vibe.ts"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./schema": {
        "types": "./dist/schema.d.ts",
        "default": "./dist/schema.js"
      },
      "./engine": {
        "types": "./dist/engine.d.ts",
        "default": "./dist/engine.js"
      },
      "./transport": {
        "types": "./dist/transport.d.ts",
        "default": "./dist/transport.js"
      },
      "./rules": {
        "types": "./dist/rules.d.ts",
        "default": "./dist/rules.js"
      },
      "./validate": {
        "types": "./dist/validate.d.ts",
        "default": "./dist/validate.js"
      },
      "./tree": {
        "types": "./dist/tree.d.ts",
        "default": "./dist/tree.js"
      },
      "./schema-client": {
        "types": "./dist/schema-client.d.ts",
        "default": "./dist/schema-client.js"
      },
      "./use-page": {
        "types": "./dist/usePage.d.ts",
        "default": "./dist/usePage.js"
      },
      "./use-tree": {
        "types": "./dist/useTree.d.ts",
        "default": "./dist/useTree.js"
      },
      "./use-form-dialog": {
        "types": "./dist/useFormDialog.d.ts",
        "default": "./dist/useFormDialog.js"
      },
      "./use-actions": {
        "types": "./dist/useActions.d.ts",
        "default": "./dist/useActions.js"
      },
      "./use-references": {
        "types": "./dist/useReferences.d.ts",
        "default": "./dist/useReferences.js"
      },
      "./format": {
        "types": "./dist/format.d.ts",
        "default": "./dist/format.js"
      },
      "./vibe": {
        "types": "./dist/vibe.d.ts",
        "default": "./dist/vibe.js"
      }
    }
  }
}
