# 前端
VITE_APP_TITLE=Microkernel Admin

# 后端接口前缀。前端由同一进程托管时保持 /api；跨域部署时填完整地址。
# 注意：浏览器端不再有 mock 实现，所有数据都来自 server/。
VITE_API_BASE_URL=/api

# Vite 开发代理目标：把 /api 转发到本机 TS 后端。
API_PROXY_TARGET=http://127.0.0.1:5181

# 开发端口（scripts/*.sh 也认这个变量）。
DEV_PORT=5174

# ---------------------------------------------------------------------------
# 后端（server/ + @addzero/ui-server）：独立进程，默认 127.0.0.1:5181。
# 以下变量由服务端读取；浏览器构建时不会带入任何密钥。
# ---------------------------------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=5181

# SQLite 落盘路径（生产用 bind mount，如 /root/DockerCompose/micro-admin/data/ui.db）。
# `:memory:` 表示内存库，仅用于临时验证。
DB_FILE=.data/ui.db

# 前端构建产物目录；存在时后端一并托管，与 API 同源。
STATIC_DIR=dist

# 允许跨域的来源，逗号分隔；同源部署留空。
CORS_ORIGINS=

# 改页面配置所需权限码（与 CrudPageSchema.permissions 同一命名空间）。
SCHEMA_WRITE_PERMISSION=system:page:config
